{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AR Client",
  "version": "0.1.0",
  "identifier": "xyz.kingar1000.arclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AR Client",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "backgroundColor": "#101010"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https:; connect-src ipc: http://ipc.localhost https://textures.minecraft.net https://api.github.com; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "An open-source Minecraft Java launcher",
    "category": "Game",
    "copyright": "Copyright KingAR1000",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/companions/*", "resources/companion.json"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
