{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ar-client-social",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ar-client-social",
      "database_id": "771aff69-4495-4998-b489-7ee9fc59781f",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["0 1 * * *"] },
}
